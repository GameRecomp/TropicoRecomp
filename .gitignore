*.MP2
*.mp3
*.lng
*.bin
*.iso

# Reference captures contain game art and sound.
*.png
*.jpg
*.bmp
*.wav
*.avi
*.mp4

# Analysis databases and dumps.
*.gpr
*.rep/
*.i64
*.idb
*.dis
*.asm.txt

# Editors and OS.
.vscode/
.idea/
*.swp
.DS_Store
