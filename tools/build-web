#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Assemble the converter site: the page (web/), the converter compiled to
# WebAssembly (rc-web, through wasm-bindgen) and the shell templates.
#
#   tools/build-web SITE_DIR [TEMPLATE_DIR]
#
# TEMPLATE_DIR holds Tropico-windows.zip, Tropico-linux.zip and
# Tropico-macos.zip (made by `recomp template`); those present are copied.
# Needs the wasm32-unknown-unknown target and wasm-bindgen 0.2.130.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
site=${1:?site directory}
templates=${2:-}
cargo build --release --target wasm32-unknown-unknown -p rc-web --manifest-path recomp/Cargo.toml
rm -rf "$site"
mkdir -p "$site/templates"
wasm-bindgen --target web --no-typescript --out-dir "$site" \
    recomp/target/wasm32-unknown-unknown/release/rc_web.wasm
cp web/index.html web/app.js web/worker.js web/style.css "$site/"
cp tools/appimage/tropico.svg "$site/tropico.svg"
if [ -n "$templates" ]; then
    for s in windows linux macos; do
        [ -f "$templates/Tropico-$s.zip" ] && cp "$templates/Tropico-$s.zip" "$site/templates/"
    done
fi
echo "build-web: $site ($(du -sh "$site" | cut -f1))"
