#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Run a scripted scenario of a game and check it.
#
#   tools/run-scenario GAME SCENARIO [--accept]
#
# Reads games/GAME/scenarios/SCENARIO.conf:
#   STOP_AT=DLL!name   pass when the program first calls this import, or
#   FRAMES=N           pass when frame N has been presented
#   INPUT=file         scripted input (beside the .conf; see hle/frames.c)
#   SCREENSHOT=N       compare frame N with the accepted screenshot
#   TOLERANCE=B        differing bytes allowed in that comparison (default 0)
#   TIMEOUT=S          seconds (default 60)
# and runs build/release/games/GAME/GAME headless, on the virtual clock, on the game in $<GAME>_DIR
# (default orig/t1/app for tropico1) with a fresh user directory.
#
# The sequence of API calls (names only) and the screenshot are compared
# with the accepted ones in build/scenarios; --accept makes this run the
# reference. Traces and screenshots come from running the game, so they
# stay in build/ and never enter the repository.
set -u
cd "$(git rev-parse --show-toplevel)" || exit 2
game=${1:?game}
scenario=${2:?scenario}
accept=${3:-}
dir_s="games/$game/scenarios"
conf="$dir_s/$scenario.conf"
[ -f "$conf" ] || { echo "no scenario $conf" >&2; exit 2; }
STOP_AT=
FRAMES=
INPUT=
SCREENSHOT=
TOLERANCE=0
TIMEOUT=60
# shellcheck disable=SC1090
. "$conf"

bin="build/release/games/$game/$game"
[ -x "$bin" ] || { echo "build $bin first (cmake --build --preset release)" >&2; exit 2; }
var=$(printf '%s_DIR' "$game" | tr '[:lower:]' '[:upper:]')
case "$game" in
    tropico1) default_dir=orig/t1/app ;;
    tropico2) default_dir=orig/t2/app ;;
    *) default_dir= ;;
esac
dir=${!var:-$default_dir}

out=build/scenarios
mkdir -p "$out"
base="$out/$game-$scenario"
user=$(mktemp -d)
log="$base.log"
shot=
[ -n "$SCREENSHOT" ] && shot="$SCREENSHOT:$base.bmp"
rm -f "$base.bmp"
RC_CLOCK=virtual SDL_VIDEO_DRIVER=${SDL_VIDEO_DRIVER:-offscreen} RC_STOP_AT="$STOP_AT" RC_FRAMES="$FRAMES" \
    RC_INPUT="${INPUT:+$dir_s/$INPUT}" RC_SCREENSHOT="$shot" RC_TRACE=imports \
    timeout "$TIMEOUT" "$bin" "$dir" "$user" > "$log" 2>&1
status=$?
rm -rf "$user"

grep -o '^\[import\] [^ (]*![^ (]*' "$log" | sed 's/^\[import\] //' > "$base.trace"
calls=$(wc -l < "$base.trace")

result=FAIL
if [ $status -eq 0 ]; then
    if [ -n "$STOP_AT" ] && grep -q "^reached $STOP_AT" "$log"; then
        result=PASS
    elif [ -n "$FRAMES" ] && grep -q "^reached frame $FRAMES" "$log"; then
        result=PASS
    fi
fi
echo "$game/$scenario: $result after $calls API calls (exit $status)"
[ "$result" = FAIL ] && tail -3 "$log"

if [ "$accept" = --accept ]; then
    cp "$base.trace" "$base.trace.ref"
    [ -f "$base.bmp" ] && cp "$base.bmp" "$base.bmp.ref"
    echo "accepted as the reference"
else
    if [ -f "$base.trace.ref" ]; then
        if cmp -s "$base.trace.ref" "$base.trace"; then
            echo "API call sequence matches the reference"
        else
            echo "API call sequence differs from the reference:"
            diff "$base.trace.ref" "$base.trace" | head -20
            result=FAIL
        fi
    fi
    if [ -n "$SCREENSHOT" ] && [ -f "$base.bmp.ref" ]; then
        if [ ! -f "$base.bmp" ]; then
            echo "no screenshot of frame $SCREENSHOT"
            result=FAIL
        else
            diff_bytes=$(cmp -l "$base.bmp.ref" "$base.bmp" 2>/dev/null | wc -l)
            if [ "$diff_bytes" -le "$TOLERANCE" ]; then
                echo "screenshot of frame $SCREENSHOT matches the reference ($diff_bytes bytes differ)"
            else
                echo "screenshot of frame $SCREENSHOT differs from the reference in $diff_bytes bytes"
                result=FAIL
            fi
        fi
    fi
fi
[ "$result" = PASS ]
