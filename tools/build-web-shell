#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Build the web shell: tropico1-shell (the game program without lifted
# code) compiled with Emscripten for a browser, with SDL3, SDL3_ttf and
# SDL3_mixer built from their releases. The converter page's "Browser"
# system plays the game with it (web/play.html).
#
#   tools/build-web-shell OUT_DIR [GAME]
#
# GAME is tropico1 (the default; tropico.js) or tropico2 (tropico2.js).
#
# Writes OUT_DIR/tropico.js and OUT_DIR/tropico.wasm (tropico2.js and
# tropico2.wasm for Tropico 2) and OUT_DIR/fonts/ (the
# Liberation fonts, from FONT_DIR or the system's fonts-liberation).
# Needs emsdk's environment (emcc, emcmake). Work happens in
# build/web-shell; the libraries are built once and reused.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
out=${1:?output directory}
game=${2:-tropico1}
. tools/game-info "$game"

# shellcheck source=tools/sdl-versions
. tools/sdl-versions

work=build/web-shell
prefix=$PWD/$work/prefix
mkdir -p "$work"

common=(-DCMAKE_BUILD_TYPE=Release "-DCMAKE_INSTALL_PREFIX=$prefix" "-DCMAKE_PREFIX_PATH=$prefix"
        "-DCMAKE_FIND_ROOT_PATH=$prefix" -DBUILD_SHARED_LIBS=OFF)

lib() {
    local name=$1 repo=$2 tag=$3 stamp
    shift 3
    stamp=$prefix/.$name-$tag
    [ -f "$stamp" ] && return 0
    rm -rf "$work/$name"
    git -c advice.detachedHead=false clone --quiet --depth 1 --branch "$tag" "https://github.com/libsdl-org/$repo.git" "$work/$name"
    for m in ${SUBMODULES:-}; do
        git -C "$work/$name" submodule --quiet update --init --depth 1 "$m"
    done
    emcmake cmake -S "$work/$name" -B "$work/$name/build" "${common[@]}" "$@" > "$work/$name.log"
    cmake --build "$work/$name/build" --parallel >> "$work/$name.log"
    cmake --install "$work/$name/build" >> "$work/$name.log"
    touch "$stamp"
}

lib sdl SDL "$SDL_TAG" -DSDL_SHARED=OFF -DSDL_STATIC=ON -DSDL_TESTS=OFF -DSDL_TEST_LIBRARY=OFF \
    -DSDL_EXAMPLES=OFF
SUBMODULES=external/freetype lib ttf SDL_ttf "$TTF_TAG" -DSDLTTF_VENDORED=ON -DSDLTTF_HARFBUZZ=OFF -DSDLTTF_PLUTOSVG=OFF \
    -DSDLTTF_SAMPLES=OFF
lib mixer SDL_mixer "$MIXER_TAG" -DSDLMIXER_VENDORED=ON -DSDLMIXER_EXAMPLES=OFF -DSDLMIXER_TESTS=OFF \
    -DSDLMIXER_MP3_MPG123=OFF -DSDLMIXER_FLAC=OFF -DSDLMIXER_MOD=OFF -DSDLMIXER_MIDI=OFF \
    -DSDLMIXER_OPUS=OFF -DSDLMIXER_VORBIS_STB=OFF -DSDLMIXER_VORBIS_VORBISFILE=OFF \
    -DSDLMIXER_WAVPACK=OFF -DSDLMIXER_GME=OFF

emcmake cmake -S . -B "$work/rc" -G Ninja "${common[@]}" -DRC_BUILD_TESTS=OFF \
    -DTROPICO1_GENERATED="$PWD/$work/none" -DTROPICO2_GENERATED="$PWD/$work/none" \
    | tee "$work/rc.log" | grep -E "^-- platform" || true
grep -q "platform: SDL3_mixer" "$work/rc.log" || { echo "build-web-shell: SDL3 or its libraries were not found" >&2; exit 1; }
cmake --build "$work/rc" --target "$game-shell" --parallel

mkdir -p "$out/fonts"
cp "$work/rc/games/$game/$GAME_WEB.js" "$work/rc/games/$game/$GAME_WEB.wasm" "$out/"
fonts=${FONT_DIR:-}
for d in "$fonts" /usr/share/fonts/truetype/liberation /usr/share/fonts/truetype/liberation2 /usr/share/fonts/liberation; do
    if [ -n "$d" ] && [ -f "$d/LiberationSans-Regular.ttf" ]; then
        for f in Sans Serif Mono; do
            for s in Regular Bold Italic; do
                cp "$d/Liberation$f-$s.ttf" "$out/fonts/"
            done
        done
        break
    fi
done
[ -f "$out/fonts/LiberationSans-Regular.ttf" ] || { echo "build-web-shell: no Liberation fonts (set FONT_DIR)" >&2; exit 1; }
echo "build-web-shell: $out ($(du -sh "$out" | cut -f1))"
