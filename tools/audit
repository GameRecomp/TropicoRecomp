#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# Check every tracked file and every commit message against the repository
# rules: no game material, no executables, no large files, no personal paths,
# an SPDX identifier in every source file, no AI attribution in messages.
#
#   tools/audit            check the working tree and all of history's messages
#   tools/audit --files    files only
set -u

cd "$(git rev-parse --show-toplevel)" || exit 2
max_bytes=524288
fail=0

reject() {
    echo "audit: $1: $2" >&2
    fail=1
}

while IFS= read -r -d '' path; do
    [ -f "$path" ] || continue
    case "$path" in
        orig/*|generated/*|build/*|out/*) reject "$path" "protected directory"; continue ;;
    esac
    lower=$(printf '%s' "$path" | tr '[:upper:]' '[:lower:]')
    case "$lower" in
        *.exe|*.dll|*.asi|*.m3d|*.flt|*.pk2|*.bik|*.imb|*.xdt|*.mp2|*.mp3|\
        *.lng|*.bin|*.iso|*.png|*.jpg|*.jpeg|*.bmp|*.wav|*.avi|*.mp4|*.ogg|\
        *.o|*.obj|*.a|*.so|*.dylib|*.wasm|*.pdb|*.gpr|*.i64|*.idb|*.dis)
            reject "$path" "file type is never committed"; continue ;;
    esac
    size=$(wc -c < "$path")
    if [ "$size" -gt "$max_bytes" ]; then
        reject "$path" "larger than $max_bytes bytes"
    fi
    magic=$(head -c 4 "$path" | od -An -tx1 | tr -d ' \n')
    case "$magic" in
        4d5a*|7f454c46|feedface|feedfacf|cefaedfe|cffaedfe|cafebabe|0061736d)
            reject "$path" "executable content"; continue ;;
    esac
    base=${lower##*/}
    is_source=0
    case "$base" in
        *.rs|*.c|*.h|*.cc|*.cpp|*.hpp|*.py|*.sh|*.js|*.mjs|*.ts|*.toml|\
        *.cmake|cmakelists.txt|*.yml|*.yaml|makefile) is_source=1 ;;
    esac
    first=$(head -n 5 "$path")
    case "$first" in '#!'*) is_source=1 ;; esac
    if [ "$is_source" -eq 1 ]; then
        case "$first" in
            *SPDX-License-Identifier:*) ;;
            *) reject "$path" "no SPDX-License-Identifier in the first five lines" ;;
        esac
    fi
    if grep -nE '/home/[A-Za-z0-9._-]+/|/Users/[A-Za-z0-9._-]+/|[A-Za-z]:\\Users\\[A-Za-z0-9._-]+' "$path" \
        | grep -vE '/home/<|/Users/<|Users\\<' | head -3 | grep -q .; then
        reject "$path" "contains a home-directory path"
    fi
done < <(git ls-files -z)

if [ "${1:-}" != "--files" ] && git rev-parse -q --verify HEAD >/dev/null; then
    tmp=$(mktemp)
    for c in $(git rev-list HEAD); do
        git log -1 --format=%B "$c" > "$tmp"
        if ! tools/hooks/commit-msg "$tmp" 2>/dev/null; then
            reject "commit $(git rev-parse --short "$c")" "message names an AI model, vendor or session, or has personal data"
        fi
    done
    rm -f "$tmp"
fi

if [ "$fail" -eq 0 ]; then
    echo "audit: clean"
fi
exit "$fail"
