#!/usr/bin/env bash
# SPDX-License-Identifier: MIT
# The programs' icons, from tools/appimage/<icon>.svg for each game's icon
# (GAME_ICON of tools/game-info: tropico, tropico2):
#
#   tools/make-icons OUT_DIR
#
# writes OUT_DIR/<icon>/png/<size>.png (16 to 1024), OUT_DIR/<icon>.ico
# (Windows) and OUT_DIR/<icon>.icns (macOS). Rendering needs rsvg-convert
# (librsvg) or ImageMagick; the containers are packed by tools/icons.py.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
out=${1:?output directory}
command -v rsvg-convert > /dev/null ||
    echo "make-icons: no rsvg-convert; ImageMagick draws no stroked paths (the palm's trunk)" >&2
for game in tropico1 tropico2; do
    . tools/game-info "$game"
    svg=tools/appimage/$GAME_ICON.svg
    png=$out/$GAME_ICON/png
    mkdir -p "$png"
    for s in 16 24 32 48 64 128 256 512 1024; do
        if command -v rsvg-convert > /dev/null; then
            rsvg-convert -w "$s" -h "$s" -o "$png/$s.png" "$svg"
        else
            magick -background none -density 384 "$svg" -resize "${s}x${s}" "PNG32:$png/$s.png"
        fi
    done
    python3 tools/icons.py "$out" "$GAME_ICON"
done
echo "make-icons: $out"
